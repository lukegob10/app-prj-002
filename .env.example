# Use the production code path. Fill the password in the private .env file.
ENV=PROD
TA_PROD_USER=LG2254
TA_PROD_PASSWORD=
TA_PROD_DSN=192.168.1.151:1521/FREEPDB1

# Local URL for the current localhost run. Use the public HTTPS URL on deployment.
AGORA_PUBLIC_ORIGIN=http://localhost:4200

# Dedicated Fernet key for saved API dataset credentials. Keep private and back up.
# Generate with: .venv/Scripts/python.exe -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
API_DATA_ENCRYPTION_KEY=

# Optional: use the Treasury Analytics connector when its distribution is installed.
AGORA_USE_TREASURY_ANALYTICS=0
# Homelab-only HTTP mode; keep disabled when serving through HTTPS.
AGORA_ALLOW_INSECURE_HTTP=0
